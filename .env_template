# --- Census ACS (REQUIRED) ---
# Free API key from https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# --- Google Cloud Storage ---
# Name of the GCS bucket holding the project datasets.
GCS_BUCKET=
# Path to your GCP service-account key file (keep the .json out of git too).
GOOGLE_APPLICATION_CREDENTIALS=

# --- Open data sources (no auth required) ---
# FEMA OpenFEMA, USGS, and Cal Fire are public and need no API key.
OPENFEMA_BASE_URL=https://www.fema.gov/api/open/v2/DisasterDeclarationsSummaries
USGS_EARTHQUAKE_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
